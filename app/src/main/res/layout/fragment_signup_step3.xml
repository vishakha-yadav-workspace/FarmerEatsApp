<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingBottom="80dp">

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FarmerEats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Step -->
        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signup 4 of 4"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Business Hours"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Choose the hours your farm is open for pickups. This will allow customers to order deliveries."
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Days Row -->
        <LinearLayout
            android:id="@+id/dayRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Example Selected Day -->
            <TextView
                android:text="M"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="T"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="W"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_selected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="Th"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="F"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="S"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <TextView
                android:text="Su"
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/day_unselected"/>

        </LinearLayout>

        <!-- Time Slots -->
        <LinearLayout
            android:id="@+id/timeSlots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/dayRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="8:00am - 10:00am"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:background="@drawable/time_selected"/>

                <Space android:layout_width="16dp" android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="10:00am - 1:00pm"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:background="@drawable/time_selected"/>
            </LinearLayout>

            <Space android:layout_height="16dp" android:layout_width="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="1:00pm - 4:00pm"
                    android:gravity="center"
                    android:background="@drawable/time_unselected"/>

                <Space android:layout_width="16dp" android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="4:00pm - 7:00pm"
                    android:gravity="center"
                    android:background="@drawable/time_unselected"/>
            </LinearLayout>

            <Space android:layout_height="16dp" android:layout_width="wrap_content"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="7:00pm - 10:00pm"
                android:gravity="center"
                android:background="@drawable/time_unselected"/>

        </LinearLayout>

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/timeSlots"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Signup Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignup"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Signup"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp"
            app:backgroundTint="#E86A4E"
            app:layout_constraintTop_toBottomOf="@id/timeSlots"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>