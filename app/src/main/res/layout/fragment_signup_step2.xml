<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- FarmerEats -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FarmerEats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Signup Step -->
        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signup 2 of 4"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Farm Info Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farm Info"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Business Name -->
        <EditText
            android:id="@+id/etBusinessName"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/edittext_bg"
            android:hint="Business Name"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Informal Name -->
        <EditText
            android:id="@+id/etInformalName"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/edittext_bg"
            android:hint="Informal Name"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etBusinessName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Street Address -->
        <EditText
            android:id="@+id/etStreet"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/edittext_bg"
            android:hint="Street Address"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etInformalName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- City -->
        <EditText
            android:id="@+id/etCity"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/edittext_bg"
            android:hint="City"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etStreet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- State + Zip Row -->
        <LinearLayout
            android:id="@+id/stateZipRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etCity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/etState"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:background="@drawable/edittext_bg"
                android:hint="State"
                android:paddingStart="16dp"/>

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etZip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter Zipcode"
                android:inputType="number"
                android:paddingStart="16dp"/>
        </LinearLayout>

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/stateZipRow"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:backgroundTint="#E86A4E"
            app:layout_constraintTop_toBottomOf="@id/stateZipRow"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>