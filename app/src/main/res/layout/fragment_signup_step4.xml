<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingBottom="80dp">

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FarmerEats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Step -->
        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signup 3 of 4"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Attached proof of Department of Agriculture registrations i.e. Florida Fresh, USDA Approved, USDA Organic"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Attach Text -->
        <TextView
            android:id="@+id/tvAttach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attach proof of registration"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/tvDesc"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Camera Button -->
        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_camera"
            android:background="@drawable/circle_orange_bg"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="@id/tvAttach"
            app:layout_constraintBottom_toBottomOf="@id/tvAttach"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Selected File Box -->
        <RelativeLayout
            android:id="@+id/layoutFile"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/file_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvAttach"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usda_registration.pdf"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_centerVertical="true"/>


        </RelativeLayout>

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toBottomOf="@id/layoutFile"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Submit"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp"
            app:backgroundTint="#E86A4E"
            app:layout_constraintTop_toBottomOf="@id/layoutFile"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="48dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>